# V11 : 설치 & 첫 명령 (vhs 시나리오, 30초)
Output ../recordings/V11-install.mp4

Set FontSize 22
Set Width 1920
Set Height 1080
Set Theme "Catppuccin Mocha"
Set TypingSpeed 50ms
Set PlaybackSpeed 1.0

Hide
Type "export PS1='$ '"
Enter
Type "clear"
Enter
Show

Type "cat ../outputs/V11-install.txt"
Enter
Sleep 25s
