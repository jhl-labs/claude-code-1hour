# V7-C — 빌드 시스템 다루기 (목표 ~75s)
COLS 140
ROWS 38
PROMPT $
TYPE_DELAY 0.035
HOLD 12.0

: type "ls drivers/mtd/nand/raw/Kconfig drivers/mtd/nand/raw/Makefile configs/sandbox_defconfig"
: enter
: output "drivers/mtd/nand/raw/Kconfig\ndrivers/mtd/nand/raw/Makefile\nconfigs/sandbox_defconfig\n"
: sleep 0.6
: prompt

: type "claude 'CONFIG_NAND_DAVINCI_V2 Kconfig 옵션 추가. 관련 Makefile, defconfig까지 일관되게. sandbox 빌드가 깨지지 않게.'"
: enter
: sleep 1.2
: cat outputs/C-build.txt
